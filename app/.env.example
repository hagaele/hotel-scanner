# Configuração do Firebase (Console do Firebase > Configurações do projeto > Seus apps > App da Web).
# Copie este arquivo para ".env" e preencha os valores. O ".env" NÃO vai para o Git.
# O prefixo EXPO_PUBLIC_ é obrigatório para o Expo disponibilizar a variável no app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
