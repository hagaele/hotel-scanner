rules_version = '2';

// Regras de segurança do Firestore do HOFIX.
// Publicar: Console do Firebase > Firestore Database > Regras > colar este arquivo > Publicar.
//
// Além de exigir login, as regras conferem o formato do que é gravado (tipos, tamanhos e faixas),
// as mesmas regras dos formulários do app. Assim, um dado gravado fora do app (pelo console do
// navegador ou pela API) não consegue quebrar as telas nem gravar valores absurdos.
//
// Importante: o login por e-mail e senha do Firebase aceita criar contas pela API mesmo sem tela
// de cadastro no app. Para que só a equipe acesse, desligue a criação de contas em
// Authentication > Settings > User actions > "Enable create (sign-up)".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function optionalText(data, field, max) {
      return !(field in data) || data[field] == null || isText(data[field], 0, max);
    }

    function isPrice(value) {
      return value is number && value > 0 && value <= 100000;
    }

    function isDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Hotel da rede ou concorrente guardado dentro do documento do hotel.
    function isProperty(p) {
      return p is map && isText(p.id, 1, 200) && isText(p.name, 1, 120) && p.latest is map
        && (!('bookingUrl' in p) || (isText(p.bookingUrl, 9, 2048) && p.bookingUrl.matches('^https://[A-Za-z0-9._~:/?#@!$&()*+,;=%-]+$')));
    }

    function isValidHotel(data) {
      return isProperty(data.own)
        && data.competitors is list && data.competitors.size() <= 5
        && optionalText(data, 'city', 80)
        && (!('floorPrice' in data) || isPrice(data.floorPrice))
        && (!('order' in data) || data.order is number);
    }

    // Cliente (nome, limite de destaque e regras de alerta): só usuário autenticado lê e escreve.
    match /clients/{clientId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && optionalText(request.resource.data, 'name', 80)
        && (!('alertThresholdPct' in request.resource.data)
            || (request.resource.data.alertThresholdPct is number
                && request.resource.data.alertThresholdPct > 0
                && request.resource.data.alertThresholdPct <= 100))
        && (!('alertRules' in request.resource.data) || request.resource.data.alertRules is map);

      // Hotéis da rede com seus concorrentes (até 5), localização e preço-piso.
      match /hotels/{hotelId} {
        allow read, delete: if signedIn();
        allow create, update: if signedIn() && isValidHotel(request.resource.data);

        // Histórico de leituras (com a data de estadia): pode ler e criar, mas nunca alterar nem apagar.
        match /checks/{checkId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && isText(request.resource.data.propertyId, 1, 200)
            && request.resource.data.status in ['ok', 'sold_out', 'blocked', 'failed']
            && (request.resource.data.price == null || isPrice(request.resource.data.price))
            && request.resource.data.checkedAt is string
            && (!('stayDate' in request.resource.data) || isDateKey(request.resource.data.stayDate));
          allow update, delete: if false;
        }

        // Decisões sobre a sugestão de preço: também só leitura e criação (ficam como histórico).
        match /decisions/{decisionId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && isDateKey(request.resource.data.stayDate)
            && request.resource.data.choice is string
            && (request.resource.data.low == null || request.resource.data.low is number)
            && (request.resource.data.high == null || request.resource.data.high is number);
          allow update, delete: if false;
        }
      }

      // Eventos e feriados locais do calendário: o usuário cadastra e remove.
      match /events/{eventId} {
        allow read, delete: if signedIn();
        allow create: if signedIn()
          && isText(request.resource.data.name, 3, 60)
          && isDateKey(request.resource.data.date)
          && request.resource.data.kind in ['evento', 'feriado', 'descartado']
          && optionalText(request.resource.data, 'city', 80);
        allow update: if false;
      }

      // Pesquisas salvas do catálogo.
      match /savedSearches/{searchId} {
        allow read, delete: if signedIn();
        allow create: if signedIn()
          && isText(request.resource.data.name, 1, 60)
          && request.resource.data.filters is map;
        allow update: if false;
      }

      // Alertas lidos: cada usuário lê e escreve só o próprio documento.
      match /userState/{userId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    // Qualquer outro caminho fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
